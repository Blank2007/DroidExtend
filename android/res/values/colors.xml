    <color name="hud_panel">#CC0A1020</color>
    <color name="hud_stroke">#44FFFFFF</color>
    <color name="hud_text">#FFFFFFFF</color>
    <color name="hud_dim">#99FFFFFF</color>
    <color name="hud_good">#FF5BE39A</color>
    <color name="hud_warn">#FFFFC45B</color>
